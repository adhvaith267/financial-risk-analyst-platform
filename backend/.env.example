# ── Application ────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── AWS ────────────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
# On EC2 with an IAM instance role attached, do NOT set AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY here. boto3 picks up the role automatically.
# For local dev, configure a named profile and set AWS_PROFILE=fra-dev.

# ── Database (RDS PostgreSQL) ───────────────────────────────────────────────────
DB_HOST=
DB_PORT=5432
DB_NAME=fra
DB_USER=fra_admin
DB_PASSWORD=

# ── SageMaker ──────────────────────────────────────────────────────────────────
SAGEMAKER_ENDPOINT_NAME=gmsc-pd-endpoint

# ── Bedrock ────────────────────────────────────────────────────────────────────
BEDROCK_MODEL_ID=moonshot.kimi-k2-thinking

# ── Risk model defaults ────────────────────────────────────────────────────────
DEFAULT_RECOVERY_RATE=0.60
CREDIT_DECLINE_THRESHOLD=0.10

# ── CORS (comma-separated origins allowed to call this API) ────────────────────
# In production behind Nginx this can be left empty (same-origin).
# For local dev: http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# ── Database pool ─────────────────────────────────────────────────────────────
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800
