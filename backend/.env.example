# ── Application ────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── Authentication ────────────────────────────────────────────────────────────
# Generate a password hash with:
# uv run python -c "from app.auth import create_password_hash; print(create_password_hash('change-me'))"
AUTH_ENABLED=true
AUTH_USERNAME=
# Keep the Argon2 value in single quotes because it contains '$' characters.
AUTH_PASSWORD_HASH=''
AUTH_SECRET_KEY=
AUTH_ROLE=analyst
AUTH_TOKEN_EXPIRE_MINUTES=60

# ── Google / Gmail login ───────────────────────────────────────────────────────
# Create an OAuth web application in Google Cloud and register the redirect URI.
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
GOOGLE_FRONTEND_REDIRECT_URI=http://localhost:5173/platform
# Use your organization domain or an explicit account list; do not allow all Gmail users.
GOOGLE_ALLOWED_EMAIL_DOMAINS=
GOOGLE_ALLOWED_EMAILS=

# ── AWS ────────────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
# On EC2 with an IAM instance role attached, do NOT set AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY here. boto3 picks up the role automatically.
# For local dev, configure a named profile and set AWS_PROFILE=fra-dev.

# ── Database (RDS PostgreSQL) ───────────────────────────────────────────────────
DB_HOST=
DB_PORT=5432
DB_NAME=fra
DB_USER=fra_admin
DB_PASSWORD=

# ── SageMaker ──────────────────────────────────────────────────────────────────
SAGEMAKER_ENDPOINT_NAME=gmsc-pd-endpoint

# ── Bedrock ────────────────────────────────────────────────────────────────────
BEDROCK_MODEL_ID=moonshot.kimi-k2-thinking

# ── Risk model defaults ────────────────────────────────────────────────────────
DEFAULT_RECOVERY_RATE=0.60
CREDIT_DECLINE_THRESHOLD=0.10

# ── CORS (comma-separated origins allowed to call this API) ────────────────────
# In production behind Nginx this can be left empty (same-origin).
# For local dev: http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# ── Database pool ─────────────────────────────────────────────────────────────
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800
