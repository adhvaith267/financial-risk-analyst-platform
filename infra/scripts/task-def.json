{
  "family": "fra-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::575264900919:role/FRA-EcsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::575264900919:role/FRA-BackendTaskRole",
  "containerDefinitions": [
    {
      "name": "fra-backend",
      "image": "575264900919.dkr.ecr.ap-south-1.amazonaws.com/fra-backend:latest",
      "portMappings": [{ "containerPort": 8000, "protocol": "tcp" }],
      "environment": [
        { "name": "AWS_REGION", "value": "ap-south-1" },
        { "name": "DB_HOST", "value": "fra-postgres-dev.cdguik0ko6d8.ap-south-1.rds.amazonaws.com" },
        { "name": "DB_PORT", "value": "5432" },
        { "name": "DB_NAME", "value": "fra" },
        { "name": "DB_USER", "value": "fra_admin" },
        { "name": "SAGEMAKER_ENDPOINT_NAME", "value": "gmsc-pd-endpoint" },
        { "name": "BEDROCK_MODEL_ID", "value": "moonshot.kimi-k2-thinking" },
        { "name": "ALLOWED_ORIGINS", "value": "https://master.d97yoeq2bkvvs.amplifyapp.com" }
      ],
      "secrets": [
        {
          "name": "DB_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:575264900919:secret:fra/rds/master-password"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/fra-backend",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "fra-backend",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
